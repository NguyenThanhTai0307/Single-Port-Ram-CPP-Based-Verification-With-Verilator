# Define the top-level module
TOP_MODULE = top

# Define the final executable name generated by Verilator
EXEC = V$(TOP_MODULE)

# Verilator tool and flags
VERILATOR = verilator
# -------------------------------------------------------------
# HEADER & INCLUDE PATHS
# -------------------------------------------------------------
# If your headers are in the current directory, use "."
# If you move them to a 'tb' or 'include' folder later, add them here (e.g., -I./tb)
INCLUDE_DIRS = -I.

# --cc: Generate C++ code
# --exe: Create an executable
# --build: Let Verilator invoke make automatically
# --trace: Enable VCD/FST waveform generation
# -O3 / -CFLAGS: Optimize the C++ model for simulation speed
# We pass $(INCLUDE_DIRS) to both Verilator and the underlying C++ compiler via -CFLAGS
# -g : enable gdb for memory leakage debugging
VFLAGS = --cc --exe --build --trace --assert \
         --timing --coverage \
         -O3 $(INCLUDE_DIRS) -CFLAGS "-O3 $(INCLUDE_DIRS)" 

# List of SystemVerilog files
SV_SRCS = design.sv\
          top.sv \
          assertion.sv

# List of C++ testbench files
CPP_SRCS = sim_main.cpp \
           sequence.cpp \
           driver.cpp \
           monitor.cpp \
           scoreboard.cpp \
           golden_model.cpp \
           functional_coverage.cpp

#=============================================================
# RUNTIME ARGUMENTS
#=============================================================
# By default, arguments are empty. 
# If the user provides a SEED from the command line, format it for Verilator.
RUN_ARGS = 
ifdef SEED
    RUN_ARGS += +verilator+seed+$(SEED)
endif  
ifdef TESTNAME
    RUN_ARGS += +TESTNAME=$(TESTNAME)
endif        

.PHONY: all build run clean

# Default target: compile and run
all: build run

# Build the simulation executable
build:
	$(VERILATOR) $(VFLAGS) --top-module $(TOP_MODULE) $(SV_SRCS) $(CPP_SRCS)

# Run the simulation
# Command Template : make run SEED=<value>
run:
	./obj_dir/$(EXEC) $(RUN_ARGS)

# Clean up generated artifacts
clean:
	rm -rf obj_dir